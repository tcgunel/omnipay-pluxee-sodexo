{
    "name": "tcgunel/omnipay-pluxee-sodexo",
    "type": "library",
    "description": "Omnipay extension for Pluxee (formerly Sodexo) - OTP based meal card payments for online checkout",
    "keywords": [
        "pluxee",
        "sodexo",
        "pluxeepay",
        "yemek karti",
        "meal card",
        "otp",
        "omnipay",
        "payment",
        "gateway"
    ],
    "homepage": "https://github.com/tcgunel/omnipay-pluxee-sodexo",
    "license": "MIT",
    "authors": [
        {
            "name": "Tolga Can Günel",
            "email": "tlgcngnl@gmail.com"
        },
        {
            "name": "Omnipay Contributors",
            "homepage": "https://github.com/tcgunel/omnipay-pluxee-sodexo/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\PluxeeSodexo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\PluxeeSodexo\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "league/omnipay": "^3",
        "psr/log": "^2.0 || ^3.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "omnipay/tests": "^4",
        "brianium/paratest": "*",
        "fzaninotto/faker": "*",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "vendor/bin/paratest --processes 6",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/pint",
        "lint-check": "vendor/bin/pint --test"
    }
}
